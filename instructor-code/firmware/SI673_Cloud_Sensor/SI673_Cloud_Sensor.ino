/*
  SI 673 Fall '26 - ESP32 Cloud Sensor

  Assumes ESP32 S3 Sense, Seeed Studio XIAO Expansion board, Seeed Studio Grove Light Sensor

  Sends:
  - JPEG photos to the instructor's /forward endpoint
  - JSON light readings to the same endpoint

  Receives JSON commands from the cloud:
    {"message":"Person detected!","light":true,"buzzer":true}

  The message, light, and buzzer are independent. A missing field
  leaves its corresponding output unchanged

  The OLED display: row 0 shows status (WiFi, upload results), row 1 the device
  ID to register in the portal, rows 3-7 the application's message.
*/

#include <Arduino.h>
#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <HTTPClient.h>
#include <Wire.h>
#include "esp_camera.h"
#include <U8x8lib.h>
#include <ArduinoJson.h>
#include <esp_arduino_version.h>
#include <esp_mac.h>

// ============================================================
// CONFIGURATION - EDIT THESE FOR YOUR NETWORK AND HARDWARE
// ============================================================

const char* WIFI_SSID = "YOUR_WIFI_SSID";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

const char* INSTRUCTOR_API =
  "https://zv03u2szki.execute-api.us-east-1.amazonaws.com/forward";

// Leave empty to auto-generate a unique ID from the chip's MAC address
// (e.g. "si673-a1b2c3") - ID is shown on the OLED display for registration
const char* DEVICE_ID_OVERRIDE = "";

const char* WELCOME_MESSAGE = "Welcome to Borromean";

const unsigned long CAMERA_INTERVAL_MS = 5000;
const unsigned long LIGHT_INTERVAL_MS = 3000;
const unsigned long WIFI_RETRY_INTERVAL_MS = 15000;

// Seeed XIAO ESP32-S3 Sense + Expansion Base for XIAO:
// Grove light sensor: A0/D0, expansion board analog Grove connector
// Expansion OLED:    I2C SDA=D4, SCL=D5 (already on expansion base)
// Passive buzzer:    D3 (GPIO4, built into expansion base)
// Onboard user LED:  GPIO21, active LOW (on XIAO ESP32-S3)
// The onboard LED shares GPIO21 with the Sense microSD CS on some
// revisions. This sketch does not use either microSD slot.
const int LIGHT_SENSOR_PIN = A0;
const int BUZZER_PIN = D3;
const int USER_LED_PIN = 21;
const int USER_LED_ON_LEVEL = LOW;
const int USER_LED_OFF_LEVEL = HIGH;

// The base has a PASSIVE buzzer that requires PWM to make a sound.
const uint32_t BUZZER_FREQUENCY_HZ = 2000;
const uint8_t BUZZER_PWM_RESOLUTION = 8;
#if ESP_ARDUINO_VERSION_MAJOR < 3
// Channel 2 uses LEDC timer 1, away from the camera's channel/timer.
const uint8_t BUZZER_PWM_CHANNEL = 2;
#endif

// The camera's 20 MHz XCLK is generated by LEDC. Arduino's ledcAttach()
// does not know about it and hands out channel 0 / timer 0 first, so the
// camera is kept on the last channel and timer to avoid the buzzer
// retuning or silencing the camera clock.
const ledc_channel_t CAMERA_LEDC_CHANNEL = LEDC_CHANNEL_7;
const ledc_timer_t CAMERA_LEDC_TIMER = LEDC_TIMER_3;

// ============================================================
// OLED OBJECT (ON EXPANSION BASE)
// ============================================================

// SSD1306 at 0x3C on the default Wire pins (SDA=D4, SCL=D5).
U8X8_SSD1306_128X64_NONAME_HW_I2C oled(U8X8_PIN_NONE);

// Layout (16 columns x 8 rows):
//   row 0      status (WiFi, upload results)
//   row 1      device ID to register in the portal
//   row 2      divider
//   rows 3-7   message returned by the student's application
const uint8_t OLED_COLS = 16;
const uint8_t OLED_ROWS = 8;
const uint8_t STATUS_ROW = 0;
const uint8_t DEVICE_ID_ROW = 1;
const uint8_t DIVIDER_ROW = 2;
const uint8_t MESSAGE_FIRST_ROW = 3;

// ============================================================
// CAMERA PINS - XIAO ESP32-S3 SENSE
// ============================================================

#define PWDN_GPIO_NUM  -1
#define RESET_GPIO_NUM -1
#define XCLK_GPIO_NUM  10
#define SIOD_GPIO_NUM  40
#define SIOC_GPIO_NUM  39

#define Y9_GPIO_NUM    48
#define Y8_GPIO_NUM    11
#define Y7_GPIO_NUM    12
#define Y6_GPIO_NUM    14
#define Y5_GPIO_NUM    16
#define Y4_GPIO_NUM    18
#define Y3_GPIO_NUM    17
#define Y2_GPIO_NUM    15

#define VSYNC_GPIO_NUM 38
#define HREF_GPIO_NUM  47
#define PCLK_GPIO_NUM  13

// ============================================================
// STATE
// ============================================================

unsigned long lastCameraSend = 0;
unsigned long lastLightSend = 0;
unsigned long lastWiFiAttempt = 0;

bool wifiAttemptStarted = false;
bool wifiWasConnected = false;
bool welcomeShown = false;
bool cameraReady = false;
bool lightIsOn = false;
bool buzzerIsOn = false;

char deviceId[32];
String currentMessage;
String serialInput;

// ============================================================
// DEVICE ID
// ============================================================

void initDeviceId() {
  if (DEVICE_ID_OVERRIDE[0] != '\0') {
    strlcpy(deviceId, DEVICE_ID_OVERRIDE, sizeof(deviceId));
    return;
  }

  // The last three MAC bytes are unique per board.
  uint8_t mac[6];
  esp_read_mac(mac, ESP_MAC_WIFI_STA);
  snprintf(deviceId, sizeof(deviceId), "si673-%02x%02x%02x",
           mac[3], mac[4], mac[5]);
}

// ============================================================
// OLED HELPERS (16 characters x 8 rows)
// ============================================================

void drawRow(uint8_t row, const char* text) {
  // Pad to the full width so a shorter line erases the previous one.
  char line[OLED_COLS + 1];
  snprintf(line, sizeof(line), "%-16.16s", text);

  // The font only covers printable ASCII (no emoji or accents).
  for (int i = 0; line[i] != '\0'; i++) {
    unsigned char c = static_cast<unsigned char>(line[i]);
    if (c < 32 || c > 126) {
      line[i] = '?';
    }
  }

  oled.drawString(0, row, line);
}

void showStatus(const char* message) {
  Serial.printf("[STATUS] %s\n", message);
  drawRow(STATUS_ROW, message);
}

// Word-wraps the message into rows 3-7; "\n" forces a new row.
// Text beyond five rows is cut off on the OLED (full text on Serial).
void showMessage(const char* message) {
  if (message == nullptr) {
    return;
  }

  // Applications often repeat the same reply every few seconds;
  // skipping identical redraws avoids visible flicker.
  if (currentMessage == message) {
    return;
  }
  currentMessage = message;

  Serial.printf("[DISPLAY] %s\n", message);

  uint8_t row = MESSAGE_FIRST_ROW;
  const char* cursor = message;

  while (row < OLED_ROWS && *cursor != '\0') {
    int length = 0;
    int lastSpace = -1;
    while (length < OLED_COLS && cursor[length] != '\0' &&
           cursor[length] != '\n') {
      if (cursor[length] == ' ') {
        lastSpace = length;
      }
      length++;
    }

    // Break at the last space instead of splitting a word.
    int advance = length;
    char following = cursor[length];
    bool splitsWord = length == OLED_COLS && following != '\0' &&
                      following != '\n' && following != ' ';
    if (splitsWord && lastSpace > 0) {
      length = lastSpace;
      advance = lastSpace + 1;
    }

    char line[OLED_COLS + 1];
    memcpy(line, cursor, length);
    line[length] = '\0';
    drawRow(row++, line);

    cursor += advance;
    if (*cursor == '\n') {
      cursor++;
    } else {
      while (*cursor == ' ') {
        cursor++;
      }
    }
  }

  while (row < OLED_ROWS) {
    drawRow(row++, "");
  }
}

void initDisplay() {
  Wire.begin(SDA, SCL);

  // Probe both common SSD1306 addresses so a missing or unseated
  // display is reported on Serial instead of failing silently.
  uint8_t address = 0;
  const uint8_t candidates[] = {0x3C, 0x3D};
  for (uint8_t candidate : candidates) {
    Wire.beginTransmission(candidate);
    if (Wire.endTransmission() == 0) {
      address = candidate;
      break;
    }
  }

  if (address == 0) {
    Serial.println("[OLED] No display at 0x3C/0x3D. Check that the XIAO");
    Serial.println("[OLED] is fully seated on the expansion base.");
    Serial.print("[OLED] I2C devices found:");
    for (uint8_t probe = 1; probe < 127; probe++) {
      Wire.beginTransmission(probe);
      if (Wire.endTransmission() == 0) {
        Serial.printf(" 0x%02X", probe);
      }
    }
    Serial.println();
    address = 0x3C;
  } else {
    Serial.printf("[OLED] Display found at 0x%02X\n", address);
  }

  // U8x8 expects the 8-bit (shifted) I2C address.
  oled.setI2CAddress(address << 1);
  oled.begin();
  oled.setPowerSave(0);
  oled.setFont(u8x8_font_chroma48medium8_r);
  oled.clearDisplay();

  // drawRow() truncates to 16 columns; the full ID is on Serial.
  char idLine[sizeof(deviceId) + 4];
  snprintf(idLine, sizeof(idLine), "ID %s", deviceId);
  drawRow(DEVICE_ID_ROW, idLine);
  drawRow(DIVIDER_ROW, "----------------");
}

// ============================================================
// INDEPENDENT HARDWARE OUTPUTS
// ============================================================

void setLight(bool enabled) {
  lightIsOn = enabled;
  digitalWrite(USER_LED_PIN,
               enabled ? USER_LED_ON_LEVEL : USER_LED_OFF_LEVEL);
  Serial.printf("[OUTPUT] Onboard LED: %s\n", enabled ? "ON" : "OFF");
}

void setBuzzer(bool enabled) {
  buzzerIsOn = enabled;
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  // Arduino ESP32 core 3.x: set an audible tone or stop PWM.
  ledcWriteTone(BUZZER_PIN, enabled ? BUZZER_FREQUENCY_HZ : 0);
#else
  // Arduino ESP32 core 2.x: tone API uses LEDC channels.
  if (enabled) {
    ledcWriteTone(BUZZER_PWM_CHANNEL, BUZZER_FREQUENCY_HZ);
  } else {
    ledcWriteTone(BUZZER_PWM_CHANNEL, 0);
  }
#endif
  Serial.printf("[OUTPUT] Passive buzzer: %s\n",
                enabled ? "ON" : "OFF");
}

// ============================================================
// CAMERA INITIALIZATION
// ============================================================

bool initCamera() {
  if (!psramFound()) {
    Serial.println("[CAMERA] PSRAM not found. Enable OPI PSRAM in Tools.");
    return false;
  }

  camera_config_t config = {};

  config.ledc_channel = CAMERA_LEDC_CHANNEL;
  config.ledc_timer = CAMERA_LEDC_TIMER;

  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;

  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;

  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;
  config.frame_size = FRAMESIZE_VGA;
  config.jpeg_quality = 12;
  config.fb_count = 1;
  config.fb_location = CAMERA_FB_IN_PSRAM;
  config.grab_mode = CAMERA_GRAB_WHEN_EMPTY;

  esp_err_t result = esp_camera_init(&config);
  if (result != ESP_OK) {
    Serial.printf("[CAMERA] Initialization failed: 0x%x\n", result);
    return false;
  }

  Serial.println("[CAMERA] Initialized");
  return true;
}

// ============================================================
// NON-BLOCKING WIFI RECONNECTION
// ============================================================

void maintainWiFi() {
  if (WiFi.status() == WL_CONNECTED) {
    if (!wifiWasConnected) {
      wifiWasConnected = true;
      Serial.print("[WIFI] Connected. IP: ");
      Serial.println(WiFi.localIP());
      showStatus(cameraReady ? "WiFi connected" : "WiFi ok, no cam");

      // Only on first connect, so a reconnect keeps the student's message.
      if (!welcomeShown) {
        welcomeShown = true;
        showMessage(WELCOME_MESSAGE);
      }
    }
    return;
  }

  if (wifiWasConnected) {
    wifiWasConnected = false;
    showStatus("WiFi disconnected");
  }

  const unsigned long now = millis();
  if (!wifiAttemptStarted ||
      now - lastWiFiAttempt >= WIFI_RETRY_INTERVAL_MS) {
    wifiAttemptStarted = true;
    lastWiFiAttempt = now;
    showStatus("Connecting WiFi");
    Serial.printf("[WIFI] Connecting to %s\n", WIFI_SSID);
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  }
}

// ============================================================
// CLOUD COMMAND PROCESSING
// ============================================================

// Handles direct JSON commands and common forwarding wrappers:
//   {"message":"Hi","light":true,"buzzer":false}
//   {"body":"{\"message\":\"Hi\",\"light\":true}"}
//   {"response":{"message":"Hi","buzzer":true}}
// Recursion is capped to prevent pathological responses.
void processCommand(JsonVariantConst value, uint8_t depth = 0) {
  if (depth > 4) {
    Serial.println("[JSON] Response nesting too deep");
    return;
  }

  if (value.is<const char*>()) {
    const char* nestedJson = value.as<const char*>();
    if (nestedJson != nullptr && nestedJson[0] == '{') {
      JsonDocument nestedDoc;
      DeserializationError err = deserializeJson(nestedDoc, nestedJson);
      if (!err) {
        processCommand(nestedDoc.as<JsonVariantConst>(), depth + 1);
      }
    }
    return;
  }

  if (!value.is<JsonObjectConst>()) {
    return;
  }

  JsonObjectConst obj = value.as<JsonObjectConst>();

  // A Lambda proxy response with an error status must not issue commands.
  if (obj["statusCode"].is<int>() && obj["statusCode"].as<int>() >= 400) {
    Serial.println("[JSON] Ignoring failed Lambda response");
    return;
  }

  // "message" is the student-facing contract; "display_message"
  // is accepted for compatibility with the original firmware.
  const char* message = obj["message"].as<const char*>();
  if (message == nullptr) {
    message = obj["display_message"].as<const char*>();
  }
  if (message != nullptr) {
    showMessage(message);
  }

  // Only update outputs when an actual JSON boolean is present.
  // Missing fields leave prior states alone, and false turns them OFF.
  if (obj["light"].is<bool>()) {
    setLight(obj["light"].as<bool>());
  }
  if (obj["buzzer"].is<bool>()) {
    setBuzzer(obj["buzzer"].as<bool>());
  }

  const char* gatewayStatus = obj["status"].as<const char*>();
  if (gatewayStatus != nullptr) {
    Serial.printf("[GATEWAY] %s\n", gatewayStatus);
  }

  // Some API Gateway/Lambda functions return a nested body or response.
  if (!obj["body"].isNull()) {
    processCommand(obj["body"], depth + 1);
  }
  if (!obj["response"].isNull()) {
    processCommand(obj["response"], depth + 1);
  }
  if (!obj["result"].isNull()) {
    processCommand(obj["result"], depth + 1);
  }
}

void parseCommandJson(const String& body) {
  if (body.length() == 0) {
    Serial.println("[JSON] Empty response (no commands)");
    return;
  }

  JsonDocument doc;
  DeserializationError error = deserializeJson(doc, body);
  if (error) {
    Serial.printf("[JSON] Parse failed: %s\n", error.c_str());
    return;
  }

  processCommand(doc.as<JsonVariantConst>());
}

// Reports the upload result on the status row, then applies any
// commands in the response.
void handleResponse(const char* dataType, int status, const String& body) {
  Serial.printf("[HTTP] Status: %d\n", status);
  Serial.printf("[HTTP] Body: %s\n", body.c_str());

  char line[OLED_COLS + 1];

  if (status < 200 || status >= 300) {
    Serial.println("[HTTP] Request failed; outputs unchanged");
    if (status == 404) {
      showStatus("Not registered");
    } else {
      // 502 means the gateway could not reach the student's endpoint.
      snprintf(line, sizeof(line), "%s: err %d", dataType, status);
      showStatus(line);
    }
    return;
  }

  JsonDocument doc;
  if (body.length() > 0 && !deserializeJson(doc, body)) {
    // The gateway answers "skipped" when no endpoint is registered
    // for this data type.
    const char* gatewayStatus = doc["status"].as<const char*>();
    bool skipped = gatewayStatus != nullptr &&
                   strcmp(gatewayStatus, "skipped") == 0;
    snprintf(line, sizeof(line), "%s: %s",
             dataType, skipped ? "no route" : "sent");
    showStatus(line);
  } else {
    snprintf(line, sizeof(line), "%s: sent", dataType);
    showStatus(line);
  }

  parseCommandJson(body);
}

// ============================================================
// SEND HTTP REQUEST TO INSTRUCTOR GATEWAY
// ============================================================

void sendToGateway(const char* dataType,
                   const uint8_t* payload,
                   size_t payloadLength,
                   const char* contentType) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("[HTTP] Skipped: WiFi disconnected");
    return;
  }

  WiFiClientSecure client;
  // Classroom prototype ONLY: encrypts TLS traffic but DOES NOT
  // validate the remote server certificate. Validate in production.
  client.setInsecure();

  HTTPClient http;
  http.setConnectTimeout(10000);
  http.setTimeout(15000);

  if (!http.begin(client, INSTRUCTOR_API)) {
    Serial.println("[HTTP] Failed to initialize request");
    return;
  }

  http.addHeader("Content-Type", contentType);
  http.addHeader("X-Device-ID", deviceId);
  http.addHeader("X-Data-Type", dataType);

  Serial.printf("[HTTP] Sending %s (%u bytes)\n",
                dataType, (unsigned int)payloadLength);

  int status = http.POST(const_cast<uint8_t*>(payload), payloadLength);
  if (status > 0) {
    handleResponse(dataType, status, http.getString());
  } else {
    Serial.printf("[HTTP] Error: %s\n",
                  http.errorToString(status).c_str());
    char line[OLED_COLS + 1];
    snprintf(line, sizeof(line), "%s: no network", dataType);
    showStatus(line);
  }

  http.end();
}

// ============================================================
// CAMERA TRANSMISSION
// ============================================================

void sendCameraImage() {
  if (!cameraReady) {
    return;
  }

  camera_fb_t* frame = esp_camera_fb_get();
  if (frame == nullptr) {
    Serial.println("[CAMERA] Capture failed");
    return;
  }

  Serial.printf("[CAMERA] Captured %u bytes\n", (unsigned int)frame->len);

  sendToGateway("image", frame->buf, frame->len, "image/jpeg");

  // Always return frame memory to the camera driver.
  esp_camera_fb_return(frame);
}

// ============================================================
// LIGHT SENSOR TRANSMISSION
// ============================================================

void sendLightReading() {
  int reading = analogRead(LIGHT_SENSOR_PIN);  // 12-bit: 0-4095
  Serial.printf("[LIGHT] Reading: %d\n", reading);

  JsonDocument doc;
  doc["type"] = "light";
  doc["value"] = reading;

  String jsonPayload;
  serializeJson(doc, jsonPayload);

  sendToGateway(
    "light",
    reinterpret_cast<const uint8_t*>(jsonPayload.c_str()),
    jsonPayload.length(),
    "application/json"
  );
}

// ============================================================
// SERIAL-ONLY TESTING (NO CLOUD REQUIRED)
// ============================================================

void pollSerialCommands() {
  while (Serial.available() > 0) {
    char incoming = static_cast<char>(Serial.read());

    if (incoming == '\n') {
      serialInput.trim();
      if (serialInput.length() > 0) {
        Serial.printf("[TEST] Command: %s\n", serialInput.c_str());
        parseCommandJson(serialInput);
      }
      serialInput = "";
    } else if (incoming != '\r') {
      if (serialInput.length() < 512) {
        serialInput += incoming;
      } else {
        serialInput = "";
        Serial.println("[TEST] Line too long (limit 512)");
      }
    }
  }
}

// ============================================================
// SETUP
// ============================================================

void setup() {
  Serial.begin(115200);
  delay(1500);

  Serial.println();
  Serial.println("==================================");
  Serial.println("SI 673 - ESP32 Cloud Sensor");
  Serial.println("==================================");

  initDeviceId();
  initDisplay();
  showStatus("Starting...");

  // Initialize both built-in outputs to OFF.
  digitalWrite(USER_LED_PIN, USER_LED_OFF_LEVEL);
  pinMode(USER_LED_PIN, OUTPUT);
  setLight(false);

  cameraReady = initCamera();
  if (!cameraReady) {
    showStatus("Camera init fail");
    Serial.println("[CAMERA] Light sensor and outputs remain available");
  }

#if ESP_ARDUINO_VERSION_MAJOR >= 3
  if (!ledcAttach(BUZZER_PIN, BUZZER_FREQUENCY_HZ,
                  BUZZER_PWM_RESOLUTION)) {
    Serial.println("[BUZZER] PWM attachment failed");
  }
#else
  ledcSetup(BUZZER_PWM_CHANNEL, BUZZER_FREQUENCY_HZ,
            BUZZER_PWM_RESOLUTION);
  ledcAttachPin(BUZZER_PIN, BUZZER_PWM_CHANNEL);
#endif
  setBuzzer(false);

  analogReadResolution(12);
  pinMode(LIGHT_SENSOR_PIN, INPUT);

  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  showMessage("Joining WiFi:");
  drawRow(MESSAGE_FIRST_ROW + 1, WIFI_SSID);
  maintainWiFi();

  unsigned long now = millis();
  lastCameraSend = now;
  lastLightSend = now;

  Serial.printf("[DEVICE] ID: %s\n", deviceId);
  Serial.println("[DEVICE] Serial command testing enabled");
  Serial.println("[DEVICE] Ready");
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop() {
  maintainWiFi();
  pollSerialCommands();

  if (WiFi.status() == WL_CONNECTED) {
    unsigned long now = millis();

    if (cameraReady && now - lastCameraSend >= CAMERA_INTERVAL_MS) {
      lastCameraSend = now;
      sendCameraImage();
    }

    // Check millis() again because the image POST may take seconds.
    now = millis();
    if (now - lastLightSend >= LIGHT_INTERVAL_MS) {
      lastLightSend = now;
      sendLightReading();
    }
  }

  delay(20);
}
